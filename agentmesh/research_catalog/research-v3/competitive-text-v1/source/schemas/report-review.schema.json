{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportReviewArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "planVersionId", "attemptId", "deliverableArtifactId", "verdict", "dimensions", "revisionRound"],
  "properties": {
    "version": { "const": "report-review-v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "planVersionId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "deliverableArtifactId": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["pass", "revise", "block"] },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "issues"],
        "properties": {
          "id": { "enum": ["requirement_coverage", "question_coverage", "evidence_coverage", "reasoning_quality", "recommendation_quality", "visual_quality", "risk_disclosure"] },
          "passed": { "type": "boolean" },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "requirement_coverage" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "question_coverage" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "evidence_coverage" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "reasoning_quality" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "recommendation_quality" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "visual_quality" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "risk_disclosure" } }, "required": ["id"] } }
      ]
    },
    "revisionRound": { "enum": [0, 1] }
  },
  "allOf": [{
    "if": {
      "properties": { "verdict": { "const": "pass" } },
      "required": ["verdict"]
    },
    "then": {
      "properties": {
        "dimensions": {
          "items": {
            "properties": {
              "passed": { "const": true },
              "issues": { "maxItems": 0 }
            }
          }
        }
      }
    }
  }]
}
