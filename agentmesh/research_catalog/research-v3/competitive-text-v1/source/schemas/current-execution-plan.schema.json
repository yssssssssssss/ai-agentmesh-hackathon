{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "current-execution-plan.schema.json",
  "title": "CurrentExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "deliverable_type",
    "evidence_requirements",
    "problem_graph",
    "problem_graph_provenance",
    "capability_decisions",
    "steps",
    "candidate_metadata",
    "activated_nodes"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "deliverable_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "evidence_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRequirement" }
    },
    "problem_graph": { "$ref": "#/$defs/problemGraph" },
    "problem_graph_provenance": { "$ref": "#/$defs/problemGraphProvenance" },
    "capability_decisions": { "$ref": "#/$defs/capabilityDecisions" },
    "capability_gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityGap" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "candidate_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rationale", "tradeoffs"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "tradeoffs": { "type": "string", "minLength": 1 }
      }
    },
    "activated_nodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptedClasses", "minimumCount", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "acceptedClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["public_source", "screenshot", "user_input", "knowledge", "dataset", "simulation", "derived"]
          }
        },
        "minimumCount": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" }
      }
    },
    "researchQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "rationale",
        "priority",
        "success_criterion_ids",
        "evidence_requirements",
        "acceptance_criteria",
        "depends_on"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["required", "optional"] },
        "success_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRequirement" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "problemGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "questions"],
      "properties": {
        "version": { "const": "problem-graph-v1" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/researchQuestion" }
        }
      }
    },
    "problemGraphProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "modelName", "modelVersion", "promptHash", "traceId"],
      "properties": {
        "receiptId": { "type": "string", "format": "uuid" },
        "modelName": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "promptHash": { "type": "string", "minLength": 1 },
        "traceId": { "type": "string", "minLength": 1 }
      }
    },
    "capabilityReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "skill_inactive",
            "task_type_mismatch",
            "required_tool_missing",
            "required_tool_inactive",
            "required_tool_health_unknown",
            "required_tool_unhealthy",
            "core_tool_real_adapter_unavailable",
            "approval_unavailable",
            "pending_input_required",
            "eligible"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "related_id": { "type": "string", "minLength": 1 }
      }
    },
    "capabilityPendingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "label", "multiple", "capability_id"],
      "properties": {
        "kind": { "enum": ["value", "visual"] },
        "role": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "multiple": { "type": "boolean" },
        "capability_id": { "type": "string", "minLength": 1 }
      }
    },
    "capabilitySkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "task_types", "inputs", "outputs", "required_tools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "when_to_use": { "type": "string" },
        "owner": { "type": "string" },
        "status": { "enum": ["draft", "active", "deprecated"] },
        "task_types": { "type": "array", "items": { "type": "string" } },
        "intent_tags": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "visual_inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "multiple_visual_inputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "input_schema": { "type": "string" },
        "output_schema": { "type": "string" },
        "payload_schema": { "type": "string" },
        "entry": { "type": "string" },
        "required_tools": { "type": "array", "items": { "type": "string" } },
        "optional_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cost_level": { "type": "string" },
        "risk_level": { "enum": ["low", "medium", "high"] }
      }
    },
    "capabilityApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_type", "capability_id", "authority"],
      "properties": {
        "capability_type": { "enum": ["skill", "tool"] },
        "capability_id": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["owner", "legal", "security"] }
      }
    },
    "capabilityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "required_approvals", "reasons", "pending_inputs"],
      "properties": {
        "skill": { "$ref": "#/$defs/capabilitySkill" },
        "required_approvals": { "type": "array", "items": { "$ref": "#/$defs/capabilityApproval" } },
        "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capabilityReason" } },
        "pending_inputs": { "type": "array", "items": { "$ref": "#/$defs/capabilityPendingInput" } },
        "optional_tool_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/optionalToolDecision" }
        }
      }
    },
    "optionalToolDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "status"],
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["available", "unavailable"] },
        "reason_code": {
          "enum": [
            "optional_tool_health_unknown",
            "optional_tool_unhealthy",
            "optional_tool_real_adapter_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["reason_code"] },
                { "required": ["message"] }
              ]
            }
          },
          "else": { "required": ["reason_code", "message"] }
        }
      ]
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_type", "capability_id", "code", "message"],
      "properties": {
        "capability_type": { "const": "tool" },
        "capability_id": { "type": "string", "minLength": 1 },
        "code": {
          "enum": [
            "optional_tool_health_unknown",
            "optional_tool_unhealthy",
            "optional_tool_real_adapter_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "capabilityDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "rejected"],
      "properties": {
        "eligible": { "type": "array", "items": { "$ref": "#/$defs/capabilityDecision" } },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/capabilityDecision" } }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_pointer", "source_step_no", "source_pointer"],
      "properties": {
        "target_pointer": { "type": "string", "pattern": "^/" },
        "source_step_no": { "type": "integer", "minimum": 1 },
        "source_pointer": { "type": "string", "pattern": "^/" }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "description"],
      "properties": {
        "pointer": { "type": "string", "pattern": "^/" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_no",
        "step_name",
        "actor_type",
        "actor_id",
        "question_ids",
        "depends_on",
        "input",
        "input_bindings",
        "expected_outputs",
        "acceptance_criteria",
        "requires_approval",
        "fallback_actor_ids"
      ],
      "properties": {
        "step_no": { "type": "integer", "minimum": 1 },
        "step_name": { "type": "string", "minLength": 1 },
        "actor_type": { "enum": ["tool", "skill", "llm", "reviewer"] },
        "actor_id": { "type": "string", "minLength": 1 },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "input": { "type": "object" },
        "input_bindings": { "type": "array", "items": { "$ref": "#/$defs/inputBinding" } },
        "expected_outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expectedOutput" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requires_approval": { "type": "boolean" },
        "approval_role": { "enum": ["owner", "legal", "security"] },
        "fallback_actor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "requires_approval": { "const": true } } },
          "then": { "required": ["approval_role"] },
          "else": { "not": { "required": ["approval_role"] } }
        }
      ]
    }
  }
}
