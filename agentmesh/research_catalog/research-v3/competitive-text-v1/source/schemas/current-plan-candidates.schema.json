{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "current-plan-candidates.schema.json",
  "title": "CurrentPlanCandidates",
  "description": "Current planning output containing exactly the depth and speed candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "allOf": [
            { "$ref": "#/$defs/candidate" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "depth" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/candidate" },
            {
              "type": "object",
              "properties": {
                "id": { "const": "speed" }
              }
            }
          ]
        }
      ],
      "additionalItems": false
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "rationale", "tradeoffs", "steps", "assumptions"],
      "properties": {
        "id": { "type": "string", "enum": ["depth", "speed"] },
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "tradeoffs": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "assumptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assumption" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_no", "step_name", "actor_type", "actor_id"],
      "properties": {
        "step_no": { "type": "integer", "minimum": 1 },
        "step_name": { "type": "string", "minLength": 1 },
        "actor_type": {
          "type": "string",
          "enum": ["tool", "skill", "llm", "reviewer"]
        },
        "actor_id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "input": { "type": "object" },
        "requires_approval": { "type": "boolean" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "editable"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "editable": { "type": "boolean" }
      }
    }
  }
}
