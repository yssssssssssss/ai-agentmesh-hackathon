{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "problem-graph.schema.json",
  "title": "ProblemGraph",
  "description": "A question-oriented, evidence-aware DAG for a finalized research task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "questions"],
  "properties": {
    "version": { "const": "problem-graph-v1" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "rationale",
        "priority",
        "success_criterion_ids",
        "evidence_requirements",
        "acceptance_criteria",
        "depends_on"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["required", "optional"] },
        "success_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRequirement" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptedClasses", "minimumCount", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "acceptedClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "public_source",
              "screenshot",
              "user_input",
              "knowledge",
              "dataset",
              "simulation",
              "derived"
            ]
          }
        },
        "minimumCount": { "type": "integer", "minimum": 1 },
        "required": { "type": "boolean" }
      }
    }
  }
}
