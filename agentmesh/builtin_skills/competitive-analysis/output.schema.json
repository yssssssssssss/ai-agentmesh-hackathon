{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentmesh://skills/competitive-analysis/output-v1",
  "type": "object",
  "required": ["summary", "facts", "inferences", "recommendations", "gaps"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "inferences": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "statement",
        "evidence_ids",
        "parent_claim_ids",
        "question_ids",
        "success_criterion_ids",
        "confidence",
        "conflict_status"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^claim_[a-zA-Z0-9_-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^evidence_[a-zA-Z0-9_-]+$"},
          "uniqueItems": true
        },
        "parent_claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^claim_[a-zA-Z0-9_-]+$"},
          "uniqueItems": true
        },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^q_[a-z0-9_]+$"},
          "uniqueItems": true
        },
        "success_criterion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^sc_[a-z0-9_]+$"},
          "uniqueItems": true
        },
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "conflict_status": {
          "type": "string",
          "enum": ["unknown", "none", "possible", "conflicting"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
