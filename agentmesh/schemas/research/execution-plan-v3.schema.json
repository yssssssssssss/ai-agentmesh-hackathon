{
  "$defs": {
    "CapabilityApprovalV3": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "owner",
            "legal",
            "security"
          ],
          "title": "Authority",
          "type": "string"
        },
        "capability_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Capability Id",
          "type": "string"
        },
        "capability_type": {
          "enum": [
            "skill",
            "tool"
          ],
          "title": "Capability Type",
          "type": "string"
        }
      },
      "required": [
        "capability_type",
        "capability_id",
        "authority"
      ],
      "title": "CapabilityApprovalV3",
      "type": "object"
    },
    "CapabilityDecisionV3": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "tool",
            "skill"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "optional_tool_decisions": {
          "items": {
            "$ref": "#/$defs/OptionalToolDecisionV3"
          },
          "title": "Optional Tool Decisions",
          "type": "array",
          "uniqueItems": true
        },
        "pending_inputs": {
          "items": {
            "$ref": "#/$defs/CapabilityPendingInputV3"
          },
          "title": "Pending Inputs",
          "type": "array"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/CapabilityReasonV3"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "required_approvals": {
          "items": {
            "$ref": "#/$defs/CapabilityApprovalV3"
          },
          "title": "Required Approvals",
          "type": "array"
        },
        "status": {
          "enum": [
            "eligible",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id",
        "status",
        "required_approvals",
        "reasons",
        "pending_inputs",
        "optional_tool_decisions"
      ],
      "title": "CapabilityDecisionV3",
      "type": "object"
    },
    "CapabilityGapV3": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Capability Id",
          "type": "string"
        },
        "capability_type": {
          "enum": [
            "tool",
            "skill",
            "llm",
            "reviewer"
          ],
          "title": "Capability Type",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "capability_type",
        "capability_id",
        "code",
        "message",
        "required"
      ],
      "title": "CapabilityGapV3",
      "type": "object"
    },
    "CapabilityPendingInputV3": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Capability Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "value",
            "visual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 240,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "multiple": {
          "title": "Multiple",
          "type": "boolean"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "role",
        "label",
        "multiple",
        "capability_id"
      ],
      "title": "CapabilityPendingInputV3",
      "type": "object"
    },
    "CapabilityReasonV3": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "related_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "CapabilityReasonV3",
      "type": "object"
    },
    "EvidenceRequirementV1": {
      "additionalProperties": false,
      "properties": {
        "accepted_classes": {
          "items": {
            "enum": [
              "public_source",
              "screenshot",
              "user_input",
              "knowledge",
              "dataset",
              "simulation",
              "derived"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Accepted Classes",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "minimum_count": {
          "maximum": 20,
          "minimum": 1,
          "title": "Minimum Count",
          "type": "integer"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "accepted_classes",
        "minimum_count",
        "required"
      ],
      "title": "EvidenceRequirementV1",
      "type": "object"
    },
    "ExpectedOutputV3": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "pointer": {
          "maxLength": 500,
          "pattern": "^/",
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "description"
      ],
      "title": "ExpectedOutputV3",
      "type": "object"
    },
    "OptionalToolDecisionV3": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "maxLength": 300,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "optional_tool_health_unknown",
                "optional_tool_unhealthy",
                "optional_tool_real_adapter_unavailable",
                "not_enabled_in_slice"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "status"
      ],
      "title": "OptionalToolDecisionV3",
      "type": "object"
    },
    "PlanInputBindingV3": {
      "additionalProperties": false,
      "properties": {
        "source_pointer": {
          "maxLength": 500,
          "pattern": "^/",
          "title": "Source Pointer",
          "type": "string"
        },
        "source_step_number": {
          "maximum": 8,
          "minimum": 1,
          "title": "Source Step Number",
          "type": "integer"
        },
        "target_pointer": {
          "maxLength": 500,
          "pattern": "^/",
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "source_step_number",
        "source_pointer",
        "target_pointer"
      ],
      "title": "PlanInputBindingV3",
      "type": "object"
    },
    "PlanStepV3": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "maxLength": 1000,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Actor Snapshot Hash",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "tool",
            "skill",
            "llm",
            "reviewer"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "approval_role": {
          "anyOf": [
            {
              "enum": [
                "owner",
                "legal",
                "security"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Role"
        },
        "contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Hash",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maximum": 8,
            "minimum": 1,
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array",
          "uniqueItems": true
        },
        "expected_outputs": {
          "items": {
            "$ref": "#/$defs/ExpectedOutputV3"
          },
          "minItems": 1,
          "title": "Expected Outputs",
          "type": "array"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "input_bindings": {
          "items": {
            "$ref": "#/$defs/PlanInputBindingV3"
          },
          "title": "Input Bindings",
          "type": "array"
        },
        "input_schema_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Schema Hash",
          "type": "string"
        },
        "invocation_semantics": {
          "enum": [
            "tool_read",
            "skill_once",
            "llm_once",
            "reviewer_once"
          ],
          "title": "Invocation Semantics",
          "type": "string"
        },
        "max_sends": {
          "maximum": 3,
          "minimum": 1,
          "title": "Max Sends",
          "type": "integer"
        },
        "name": {
          "maxLength": 120,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "output_schema_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Schema Hash",
          "type": "string"
        },
        "question_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Question Ids",
          "type": "array",
          "uniqueItems": true
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "step_number": {
          "maximum": 8,
          "minimum": 1,
          "title": "Step Number",
          "type": "integer"
        },
        "timeout_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "step_number",
        "name",
        "actor_type",
        "actor_id",
        "question_ids",
        "depends_on",
        "input",
        "input_bindings",
        "expected_outputs",
        "acceptance_criteria",
        "required",
        "requires_approval",
        "timeout_seconds",
        "max_sends",
        "invocation_semantics",
        "actor_snapshot_hash",
        "input_schema_hash",
        "output_schema_hash",
        "contract_hash"
      ],
      "title": "PlanStepV3",
      "type": "object"
    },
    "ProblemGraphArtifactRefV3": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "const": "problem_graph",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "problem-graph-v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "content_hash"
      ],
      "title": "ProblemGraphArtifactRefV3",
      "type": "object"
    },
    "SealedArtifactRefV3": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "content_hash"
      ],
      "title": "SealedArtifactRefV3",
      "type": "object"
    }
  },
  "$id": "execution-plan-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "candidate_id": {
            "const": "speed"
          }
        },
        "required": [
          "candidate_id"
        ]
      },
      "then": {
        "properties": {
          "steps": {
            "maxItems": 4
          }
        }
      }
    }
  ],
  "properties": {
    "activated_nodes": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
        "type": "string"
      },
      "title": "Activated Nodes",
      "type": "array",
      "uniqueItems": true
    },
    "candidate_id": {
      "enum": [
        "depth",
        "speed"
      ],
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_rationale": {
      "maxLength": 2000,
      "pattern": "\\S",
      "title": "Candidate Rationale",
      "type": "string"
    },
    "candidate_title": {
      "maxLength": 240,
      "pattern": "\\S",
      "title": "Candidate Title",
      "type": "string"
    },
    "candidate_tradeoffs": {
      "maxLength": 2000,
      "pattern": "\\S",
      "title": "Candidate Tradeoffs",
      "type": "string"
    },
    "capability_decisions": {
      "items": {
        "$ref": "#/$defs/CapabilityDecisionV3"
      },
      "title": "Capability Decisions",
      "type": "array"
    },
    "capability_gaps": {
      "items": {
        "$ref": "#/$defs/CapabilityGapV3"
      },
      "title": "Capability Gaps",
      "type": "array"
    },
    "control_snapshot_artifact": {
      "$ref": "#/$defs/SealedArtifactRefV3"
    },
    "deliverable_type": {
      "const": "competitive_analysis_report",
      "title": "Deliverable Type",
      "type": "string"
    },
    "evidence_requirements": {
      "items": {
        "$ref": "#/$defs/EvidenceRequirementV1"
      },
      "title": "Evidence Requirements",
      "type": "array"
    },
    "execution_budget_seconds": {
      "const": 300,
      "default": 300,
      "title": "Execution Budget Seconds",
      "type": "integer"
    },
    "max_tool_calls": {
      "const": 24,
      "default": 24,
      "title": "Max Tool Calls",
      "type": "integer"
    },
    "max_wave_concurrency": {
      "const": 3,
      "default": 3,
      "title": "Max Wave Concurrency",
      "type": "integer"
    },
    "payload_schema_version": {
      "const": "competitive-analysis-text-v1",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "problem_graph_artifact": {
      "$ref": "#/$defs/ProblemGraphArtifactRefV3"
    },
    "requirement_content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Requirement Content Hash",
      "type": "string"
    },
    "requirement_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Requirement Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": "execution-plan-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStepV3"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "task_type": {
      "const": "competitive_research",
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_type",
    "requirement_version_id",
    "requirement_content_hash",
    "problem_graph_artifact",
    "candidate_id",
    "deliverable_type",
    "payload_schema_version",
    "evidence_requirements",
    "capability_decisions",
    "capability_gaps",
    "steps",
    "candidate_title",
    "candidate_rationale",
    "candidate_tradeoffs",
    "activated_nodes",
    "control_snapshot_artifact"
  ],
  "title": "ExecutionPlanV3",
  "type": "object"
}
