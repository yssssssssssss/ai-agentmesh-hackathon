    "ActionRecommendationV1": {
      "additionalProperties": false,
      "properties": {
        "difference_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Difference Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "title": "Priority",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "difference_ids",
        "priority",
        "statement"
      ],
      "title": "ActionRecommendationV1",
      "type": "object"
    },
    "AnalysisNodeV3": {
      "additionalProperties": false,
