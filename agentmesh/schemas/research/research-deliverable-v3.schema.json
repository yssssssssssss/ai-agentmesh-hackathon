  "$id": "research-deliverable-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "capability_provenance": {
      "items": {
        "$ref": "#/$defs/CapabilityProvenanceV3"
      },
      "title": "Capability Provenance",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/ResearchDeliverableCoverageV3"
    },
    "deliverable_type": {
      "const": "competitive_analysis_report",
      "default": "competitive_analysis_report",
      "title": "Deliverable Type",
      "type": "string"
    },
    "evidence_manifest_artifact": {
      "$ref": "#/$defs/EvidenceManifestArtifactRefV3"
    },
    "finding_graph": {
      "$ref": "#/$defs/FindingGraphV3"
    },
    "method_summary": {
      "maxLength": 4000,
      "title": "Method Summary",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/CompetitiveAnalysisTextPayloadV1"
    },
    "payload_schema_version": {
      "const": "competitive-analysis-text-v1",
      "default": "competitive-analysis-text-v1",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "plan_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Plan Version Id",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/RecommendationV3"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "requirement_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Requirement Version Id",
      "type": "string"
    },
    "risks_and_open_issues": {
      "items": {
        "maxLength": 4000,
