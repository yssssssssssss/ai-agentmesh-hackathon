    "CompetitiveAnalysisTextPayloadV1": {
      "additionalProperties": false,
      "properties": {
        "action_recommendations": {
          "items": {
            "$ref": "#/$defs/ActionRecommendationV1"
          },
          "minItems": 1,
          "title": "Action Recommendations",
          "type": "array"
        },
        "competitor_samples": {
          "items": {
            "$ref": "#/$defs/CompetitorSampleV1"
          },
          "minItems": 1,
          "title": "Competitor Samples",
          "type": "array"
        },
        "differences": {
          "items": {
            "$ref": "#/$defs/DifferenceV1"
          },
          "minItems": 1,
          "title": "Differences",
          "type": "array"
        },
        "dimension_matrix": {
          "items": {
            "$ref": "#/$defs/DimensionMatrixRowV1"
          },
          "minItems": 1,
          "title": "Dimension Matrix",
          "type": "array"
        },
        "impacts": {
          "items": {
            "$ref": "#/$defs/ImpactV1"
          },
          "minItems": 1,
          "title": "Impacts",
          "type": "array"
        },
        "instrumentation_plan": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instrumentation Plan"
        },
        "management_summary": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Management Summary"
        },
        "roadmap": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RoadmapItemV1"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roadmap"
        },
        "scoring_method": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scoring Method"
        },
        "screenshot_comparisons": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Screenshot Comparisons",
          "type": "array"
        },
        "user_test_script": {
          "anyOf": [
            {
              "items": {
                "maxLength": 4000,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Test Script"
        },
        "visual_evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Visual Evidence",
          "type": "array"
        }
      },
      "required": [
        "competitor_samples",
        "dimension_matrix",
        "differences",
        "impacts",
        "action_recommendations",
        "visual_evidence",
        "screenshot_comparisons"
      ],
      "title": "CompetitiveAnalysisTextPayloadV1",
      "type": "object"
    },
