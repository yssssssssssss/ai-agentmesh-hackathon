{
  "$defs": {
    "DepthPlanCandidateV3": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/ResearchAssumptionV3"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "candidate_id": {
          "const": "depth",
          "title": "Candidate Id",
          "type": "string"
        },
        "proposed_steps": {
          "items": {
            "$ref": "#/$defs/PlanStepProposalV3"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Proposed Steps",
          "type": "array"
        },
        "rationale": {
          "maxLength": 2000,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "tradeoffs": {
          "maxLength": 2000,
          "pattern": "\\S",
          "title": "Tradeoffs",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "title",
        "rationale",
        "tradeoffs",
        "assumptions",
        "proposed_steps"
      ],
      "title": "DepthPlanCandidateV3",
      "type": "object"
    },
    "ExpectedOutputV3": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "pointer": {
          "maxLength": 500,
          "pattern": "^/",
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "pointer",
        "description"
      ],
      "title": "ExpectedOutputV3",
      "type": "object"
    },
    "PlanInputBindingV3": {
      "additionalProperties": false,
      "properties": {
        "source_pointer": {
          "maxLength": 500,
          "pattern": "^/",
          "title": "Source Pointer",
          "type": "string"
        },
        "source_step_number": {
          "maximum": 8,
          "minimum": 1,
          "title": "Source Step Number",
          "type": "integer"
        },
        "target_pointer": {
          "maxLength": 500,
          "pattern": "^/",
          "title": "Target Pointer",
          "type": "string"
        }
      },
      "required": [
        "source_step_number",
        "source_pointer",
        "target_pointer"
      ],
      "title": "PlanInputBindingV3",
      "type": "object"
    },
    "PlanStepProposalV3": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criteria": {
          "items": {
            "maxLength": 1000,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "tool",
            "skill",
            "llm",
            "reviewer"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "approval_role": {
          "anyOf": [
            {
              "enum": [
                "owner",
                "legal",
                "security"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Role"
        },
        "depends_on": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Depends On",
          "type": "array",
          "uniqueItems": true
        },
        "expected_outputs": {
          "items": {
            "$ref": "#/$defs/ExpectedOutputV3"
          },
          "title": "Expected Outputs",
          "type": "array"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "input_bindings": {
          "items": {
            "$ref": "#/$defs/PlanInputBindingV3"
          },
          "title": "Input Bindings",
          "type": "array"
        },
        "name": {
          "maxLength": 120,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "proposed_step_number": {
          "minimum": 1,
          "title": "Proposed Step Number",
          "type": "integer"
        },
        "question_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array",
          "uniqueItems": true
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        }
      },
      "required": [
        "proposed_step_number",
        "name",
        "actor_type",
        "actor_id",
        "question_ids",
        "depends_on",
        "input",
        "input_bindings",
        "expected_outputs",
        "acceptance_criteria",
        "requires_approval"
      ],
      "title": "PlanStepProposalV3",
      "type": "object"
    },
    "ResearchAssumptionV3": {
      "additionalProperties": false,
      "properties": {
        "editable": {
          "title": "Editable",
          "type": "boolean"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 2000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "editable"
      ],
      "title": "ResearchAssumptionV3",
      "type": "object"
    },
    "SpeedPlanCandidateV3": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/ResearchAssumptionV3"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "candidate_id": {
          "const": "speed",
          "title": "Candidate Id",
          "type": "string"
        },
        "proposed_steps": {
          "items": {
            "$ref": "#/$defs/PlanStepProposalV3"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Proposed Steps",
          "type": "array"
        },
        "rationale": {
          "maxLength": 2000,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "tradeoffs": {
          "maxLength": 2000,
          "pattern": "\\S",
          "title": "Tradeoffs",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "title",
        "rationale",
        "tradeoffs",
        "assumptions",
        "proposed_steps"
      ],
      "title": "SpeedPlanCandidateV3",
      "type": "object"
    }
  },
  "$id": "plan-candidates-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/DepthPlanCandidateV3"
        },
        {
          "$ref": "#/$defs/SpeedPlanCandidateV3"
        }
      ],
      "title": "Candidates",
      "type": "array"
    },
    "schema_version": {
      "const": "plan-candidates-v3",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidates"
  ],
  "title": "PlanCandidateSetV3",
  "type": "object"
}
