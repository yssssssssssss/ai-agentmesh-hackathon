{
  "$defs": {
    "FactBlockV3": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "fact",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "text",
        "evidence_ids"
      ],
      "title": "FactBlockV3",
      "type": "object"
    },
    "ListBlockV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "maxLength": 20000,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "const": "list",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "title": "ListBlockV3",
      "type": "object"
    },
    "MetricBlockV3": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "type": {
          "const": "metric",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "value",
        "evidence_ids"
      ],
      "title": "MetricBlockV3",
      "type": "object"
    },
    "ParagraphBlockV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "paragraph",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "text"
      ],
      "title": "ParagraphBlockV3",
      "type": "object"
    },
    "ReportSectionV3": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "fact": "#/$defs/FactBlockV3",
                "list": "#/$defs/ListBlockV3",
                "metric": "#/$defs/MetricBlockV3",
                "paragraph": "#/$defs/ParagraphBlockV3"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ParagraphBlockV3"
              },
              {
                "$ref": "#/$defs/FactBlockV3"
              },
              {
                "$ref": "#/$defs/MetricBlockV3"
              },
              {
                "$ref": "#/$defs/ListBlockV3"
              }
            ]
          },
          "title": "Blocks",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "question_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "question_ids",
        "blocks"
      ],
      "title": "ReportSectionV3",
      "type": "object"
    },
    "SealedArtifactRefV3": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "content_hash"
      ],
      "title": "SealedArtifactRefV3",
      "type": "object"
    }
  },
  "$id": "report-document-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "deliverable_artifact": {
      "$ref": "#/$defs/SealedArtifactRefV3"
    },
    "executive_summary": {
      "maxLength": 20000,
      "pattern": "\\S",
      "title": "Executive Summary",
      "type": "string"
    },
    "plan_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Plan Version Id",
      "type": "string"
    },
    "presentation_mode": {
      "const": "text",
      "title": "Presentation Mode",
      "type": "string"
    },
    "requirement_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Requirement Version Id",
      "type": "string"
    },
    "review_artifact": {
      "$ref": "#/$defs/SealedArtifactRefV3"
    },
    "review_verdict": {
      "const": "pass",
      "title": "Review Verdict",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "report-document-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": false,
      "maxItems": 13,
      "minItems": 13,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "cover"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "executive-summary"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "background"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "scope-method"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "key-metrics"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "findings"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "question-analysis"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "visual-evidence"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "comparison"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "conclusion"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "recommendations"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "risks"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ReportSectionV3"
            },
            {
              "properties": {
                "id": {
                  "const": "appendix"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          ]
        }
      ],
      "title": "Sections",
      "type": "array"
    },
    "subtitle": {
      "maxLength": 1000,
      "pattern": "\\S",
      "title": "Subtitle",
      "type": "string"
    },
    "template_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Template Snapshot Hash",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "presentation_mode",
    "review_verdict",
    "run_id",
    "requirement_version_id",
    "plan_version_id",
    "attempt_id",
    "deliverable_artifact",
    "review_artifact",
    "template_snapshot_hash",
    "title",
    "subtitle",
    "executive_summary",
    "sections"
  ],
  "title": "ReportDocumentV3",
  "type": "object"
}
