{
  "$defs": {
    "AssetRefV3": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Asset Id",
          "type": "string"
        },
        "manifest_artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Manifest Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "manifest_artifact_id"
      ],
      "title": "AssetRefV3",
      "type": "object"
    },
    "ChartBlockV3": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Alt Text",
          "type": "string"
        },
        "caption": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Caption",
          "type": "string"
        },
        "chart_ref": {
          "$ref": "#/$defs/ChartRefV3"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "additionalProperties": true,
          "title": "Spec",
          "type": "object"
        },
        "spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "table": {
          "additionalProperties": true,
          "title": "Table",
          "type": "object"
        },
        "type": {
          "const": "chart",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "chart_ref",
        "spec_hash",
        "spec",
        "table",
        "caption",
        "alt_text"
      ],
      "title": "ChartBlockV3",
      "type": "object"
    },
    "ChartRefV3": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Asset Id",
          "type": "string"
        },
        "chart_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Chart Id",
          "type": "string"
        },
        "manifest_artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Manifest Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "chart_id",
        "asset_id",
        "manifest_artifact_id"
      ],
      "title": "ChartRefV3",
      "type": "object"
    },
    "FactBlockV3": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "fact",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "text",
        "evidence_ids"
      ],
      "title": "FactBlockV3",
      "type": "object"
    },
    "ImageBlockV3": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Alt Text",
          "type": "string"
        },
        "asset_ref": {
          "$ref": "#/$defs/AssetRefV3"
        },
        "caption": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Caption",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "image",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "asset_ref",
        "caption",
        "alt_text",
        "evidence_ids"
      ],
      "title": "ImageBlockV3",
      "type": "object"
    },
    "ImageComparisonBlockV3": {
      "additionalProperties": false,
      "properties": {
        "after_asset_ref": {
          "$ref": "#/$defs/AssetRefV3"
        },
        "alt_text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Alt Text",
          "type": "string"
        },
        "before_asset_ref": {
          "$ref": "#/$defs/AssetRefV3"
        },
        "caption": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Caption",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "image-comparison",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "before_asset_ref",
        "after_asset_ref",
        "caption",
        "alt_text",
        "evidence_ids"
      ],
      "title": "ImageComparisonBlockV3",
      "type": "object"
    },
    "ListBlockV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "maxLength": 20000,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "list",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "title": "ListBlockV3",
      "type": "object"
    },
    "MetricBlockV3": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "type": {
          "const": "metric",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "value",
        "evidence_ids"
      ],
      "title": "MetricBlockV3",
      "type": "object"
    },
    "ParagraphBlockV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "paragraph",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "text"
      ],
      "title": "ParagraphBlockV3",
      "type": "object"
    },
    "ReportSectionV3": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "chart": "#/$defs/ChartBlockV3",
                "fact": "#/$defs/FactBlockV3",
                "image": "#/$defs/ImageBlockV3",
                "image-comparison": "#/$defs/ImageComparisonBlockV3",
                "list": "#/$defs/ListBlockV3",
                "metric": "#/$defs/MetricBlockV3",
                "paragraph": "#/$defs/ParagraphBlockV3"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ParagraphBlockV3"
              },
              {
                "$ref": "#/$defs/FactBlockV3"
              },
              {
                "$ref": "#/$defs/MetricBlockV3"
              },
              {
                "$ref": "#/$defs/ListBlockV3"
              },
              {
                "$ref": "#/$defs/ImageBlockV3"
              },
              {
                "$ref": "#/$defs/ImageComparisonBlockV3"
              },
              {
                "$ref": "#/$defs/ChartBlockV3"
              }
            ]
          },
          "title": "Blocks",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "question_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "question_ids",
        "blocks"
      ],
      "title": "ReportSectionV3",
      "type": "object"
    },
    "SealedArtifactRefV3": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "content_hash"
      ],
      "title": "SealedArtifactRefV3",
      "type": "object"
    }
  },
  "$id": "report-document-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "deliverable_artifact": {
      "$ref": "#/$defs/SealedArtifactRefV3"
    },
    "executive_summary": {
      "maxLength": 20000,
      "pattern": "\\S",
      "title": "Executive Summary",
      "type": "string"
    },
    "plan_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Plan Version Id",
      "type": "string"
    },
    "presentation_mode": {
      "enum": [
        "text",
        "multimodal"
      ],
      "title": "Presentation Mode",
      "type": "string"
    },
    "requirement_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Requirement Version Id",
      "type": "string"
    },
    "review_artifact": {
      "$ref": "#/$defs/SealedArtifactRefV3"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "report-document-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSectionV3"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "subtitle": {
      "maxLength": 1000,
      "pattern": "\\S",
      "title": "Subtitle",
      "type": "string"
    },
    "template_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Template Snapshot Hash",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "presentation_mode",
    "run_id",
    "requirement_version_id",
    "plan_version_id",
    "attempt_id",
    "deliverable_artifact",
    "review_artifact",
    "template_snapshot_hash",
    "title",
    "subtitle",
    "executive_summary",
    "sections"
  ],
  "title": "ReportDocumentV3",
  "type": "object"
}
