{
  "$defs": {
    "EvidenceItemV3": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {
          "const": "public_source",
          "title": "Evidence Class",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "tool_output",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "$ref": "#/$defs/VerifiedArtifactPointerV3"
        },
        "proof": {
          "$ref": "#/$defs/EvidenceProofV3"
        },
        "quote_pointer": {
          "$ref": "#/$defs/VerifiedQuotePointerV3"
        },
        "redaction": {
          "enum": [
            "none",
            "masked"
          ],
          "title": "Redaction",
          "type": "string"
        },
        "sensitivity": {
          "const": "public",
          "title": "Sensitivity",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSourceV3"
        }
      },
      "required": [
        "id",
        "kind",
        "evidence_class",
        "pointer",
        "quote_pointer",
        "source",
        "proof",
        "sensitivity",
        "redaction"
      ],
      "title": "EvidenceItemV3",
      "type": "object"
    },
    "EvidenceProofV3": {
      "additionalProperties": false,
      "description": "Execution proof that prevents public facts from being detached from their Tool call.",
      "properties": {
        "actor_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "const": "tool",
          "title": "Actor Type",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "execution_mode": {
          "const": "real",
          "title": "Execution Mode",
          "type": "string"
        },
        "implementation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Implementation Id",
          "type": "string"
        },
        "plan_version_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Plan Version Id",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "redacted_output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Redacted Output Hash",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Run Id",
          "type": "string"
        },
        "step_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Step Contract Hash",
          "type": "string"
        },
        "step_number": {
          "maximum": 8,
          "minimum": 1,
          "title": "Step Number",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "plan_version_id",
        "attempt_id",
        "step_number",
        "actor_type",
        "actor_id",
        "step_contract_hash",
        "receipt_id",
        "implementation_id",
        "execution_mode",
        "redacted_output_hash"
      ],
      "title": "EvidenceProofV3",
      "type": "object"
    },
    "EvidenceSourceV3": {
      "additionalProperties": false,
      "description": "The human-auditable public source represented by one text evidence item.",
      "properties": {
        "conflict_status": {
          "enum": [
            "none",
            "corroborated",
            "conflicting"
          ],
          "title": "Conflict Status",
          "type": "string"
        },
        "independence_group": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Independence Group",
          "type": "string"
        },
        "quote": {
          "maxLength": 4000,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        },
        "registrable_domain": {
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Registrable Domain",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "risk_flags": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
            "type": "string"
          },
          "title": "Risk Flags",
          "type": "array",
          "uniqueItems": true
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "const": "public_web",
          "title": "Source Kind",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "url": {
          "maxLength": 2048,
          "pattern": "^https://[^\\s]+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "source_id",
        "title",
        "url",
        "quote",
        "retrieved_at",
        "registrable_domain",
        "independence_group",
        "conflict_status",
        "risk_flags",
        "truncated"
      ],
      "title": "EvidenceSourceV3",
      "type": "object"
    },
    "SealedArtifactRefV3": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "content_hash"
      ],
      "title": "SealedArtifactRefV3",
      "type": "object"
    },
    "VerifiedArtifactPointerV3": {
      "additionalProperties": false,
      "description": "A pointer bound to the exact sealed Artifact bytes that must be read and verified.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/SealedArtifactRefV3"
        },
        "json_pointer": {
          "maxLength": 1000,
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "title": "Json Pointer",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "json_pointer"
      ],
      "title": "VerifiedArtifactPointerV3",
      "type": "object"
    },
    "VerifiedQuotePointerV3": {
      "additionalProperties": false,
      "description": "A typed pointer to the exact quoted text within the same verified Artifact.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/SealedArtifactRefV3"
        },
        "json_pointer": {
          "maxLength": 1000,
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "title": "Json Pointer",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "json_pointer"
      ],
      "title": "VerifiedQuotePointerV3",
      "type": "object"
    }
  },
  "$id": "evidence-manifest-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Slice 1 Evidence Manifest: public, real-Tool, text-only evidence from one execution.",
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItemV3"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "payload_schema_version": {
      "const": "competitive-analysis-text-v1",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "plan_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Plan Version Id",
      "type": "string"
    },
    "presentation_mode": {
      "const": "text",
      "title": "Presentation Mode",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "evidence-manifest-v3",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "presentation_mode",
    "payload_schema_version",
    "run_id",
    "plan_version_id",
    "attempt_id",
    "collected_at",
    "evidence"
  ],
  "title": "EvidenceManifestV3",
  "type": "object"
}
