{
  "$defs": {
    "DeterministicReviewCheckV3": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "schema_valid",
            "lineage_binding_valid",
            "requirement_coverage",
            "question_coverage",
            "evidence_coverage",
            "finding_graph_valid",
            "recommendation_roots_valid",
            "gap_disclosure",
            "sensitive_content_absent",
            "artifact_hash_valid",
            "text_mode_no_visual_references"
          ],
          "title": "Code",
          "type": "string"
        },
        "dimension_id": {
          "enum": [
            "requirement_coverage",
            "question_coverage",
            "evidence_coverage",
            "reasoning_quality",
            "recommendation_quality",
            "visual_quality",
            "risk_disclosure"
          ],
          "title": "Dimension Id",
          "type": "string"
        },
        "issues": {
          "items": {
            "maxLength": 1000,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "dimension_id",
        "passed",
        "issues"
      ],
      "title": "DeterministicReviewCheckV3",
      "type": "object"
    },
    "ReviewDimensionV3": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "requirement_coverage",
            "question_coverage",
            "evidence_coverage",
            "reasoning_quality",
            "recommendation_quality",
            "visual_quality",
            "risk_disclosure"
          ],
          "title": "Id",
          "type": "string"
        },
        "issues": {
          "items": {
            "maxLength": 1000,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "passed",
        "issues"
      ],
      "title": "ReviewDimensionV3",
      "type": "object"
    },
    "SealedArtifactRefV3": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "schema_version",
        "content_hash"
      ],
      "title": "SealedArtifactRefV3",
      "type": "object"
    }
  },
  "$id": "report-review-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "deliverable_artifact": {
      "$ref": "#/$defs/SealedArtifactRefV3"
    },
    "deterministic_checks": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "code": {
                "const": "artifact_hash_valid"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "evidence_coverage"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "finding_graph_valid"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "gap_disclosure"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "lineage_binding_valid"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "question_coverage"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "recommendation_roots_valid"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "requirement_coverage"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "schema_valid"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "sensitive_content_absent"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "code": {
                "const": "text_mode_no_visual_references"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/DeterministicReviewCheckV3"
      },
      "maxItems": 11,
      "minItems": 11,
      "title": "Deterministic Checks",
      "type": "array",
      "uniqueItems": true
    },
    "dimensions": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "requirement_coverage"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "question_coverage"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "evidence_coverage"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "reasoning_quality"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "recommendation_quality"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "visual_quality"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "risk_disclosure"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/ReviewDimensionV3"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Dimensions",
      "type": "array",
      "uniqueItems": true
    },
    "plan_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Plan Version Id",
      "type": "string"
    },
    "requirement_version_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Requirement Version Id",
      "type": "string"
    },
    "revision_round": {
      "enum": [
        0,
        1
      ],
      "title": "Revision Round",
      "type": "integer"
    },
    "rubric_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rubric Snapshot Hash",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "report-review-v3",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_model_call_receipt_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Semantic Model Call Receipt Id"
    },
    "verdict": {
      "enum": [
        "pass",
        "revise",
        "block"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "requirement_version_id",
    "plan_version_id",
    "attempt_id",
    "deliverable_artifact",
    "rubric_snapshot_hash",
    "deterministic_checks",
    "semantic_model_call_receipt_id",
    "verdict",
    "dimensions",
    "revision_round"
  ],
  "title": "ReportReviewV3",
  "type": "object"
}
