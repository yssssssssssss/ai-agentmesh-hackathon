{
  "$defs": {
    "CatalogStatus": {
      "enum": [
        "draft",
        "reviewed",
        "validated",
        "planned"
      ],
      "title": "CatalogStatus",
      "type": "string"
    },
    "TaskCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "owner": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "recommended_skill_ids": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Skill Ids",
          "type": "array"
        },
        "required_knowledge_types": {
          "items": {
            "type": "string"
          },
          "title": "Required Knowledge Types",
          "type": "array"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "source_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CatalogStatus"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trigger_keywords": {
          "items": {
            "type": "string"
          },
          "title": "Trigger Keywords",
          "type": "array"
        },
        "updated_at": {
          "format": "date",
          "title": "Updated At",
          "type": "string"
        },
        "workflow_ids": {
          "items": {
            "type": "string"
          },
          "title": "Workflow Ids",
          "type": "array"
        }
      },
      "required": [
        "source_path",
        "source_hash",
        "id",
        "title",
        "description",
        "status",
        "owner",
        "updated_at"
      ],
      "title": "TaskCatalogEntry",
      "type": "object"
    }
  },
  "$id": "https://agentmesh.local/schemas/task-catalog/user-research-v2/task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/TaskCatalogEntry"
  },
  "type": "array"
}
