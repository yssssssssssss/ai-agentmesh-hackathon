AGENTMESH_DB_PATH=data/agentmesh.sqlite3
AGENTMESH_PORT=8010
# Keep legacy until the SDK runtime, model, and required Wiki corpus are configured.
AGENTMESH_AGENT_RUNTIME=legacy
AGENTMESH_WIKI_ROOT=
# Set to 1 only for a local demo database. Leave disabled in production.
AGENTMESH_DEMO_MODE=0
AGENTMESH_EMBEDDING_ENABLED=false
AGENTMESH_EMBEDDING_API_URL=http://internal-llm-gateway/v1/embeddings
AGENTMESH_EMBEDDING_API_KEY=replace-with-your-key
AGENTMESH_EMBEDDING_MODEL=Qwen3-Embedding-8B-joybuilder
# OpenAI-compatible chat gateway. Keep real API keys in ignored .env only.
AI_API_URL=http://internal-llm-gateway/v1/chat/completions
AI_API_KEY=replace-with-your-key
AI_MODEL=GPT-5.2-joybuilder
AI_API_STYLE=chat_completions
AGENTMESH_MODEL_DEFAULT=default
AGENTMESH_MODELS=gpt52,gpt54,gpt55,kimi_k26
AGENTMESH_MODEL_GPT52_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_GPT52_API_KEY=replace-with-your-key
AGENTMESH_MODEL_GPT52_MODEL=GPT-5.2-joybuilder
AGENTMESH_MODEL_GPT52_LABEL=GPT-5.2 JoyBuilder
AGENTMESH_MODEL_GPT52_API_STYLE=chat_completions
AGENTMESH_MODEL_GPT54_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_GPT54_API_KEY=replace-with-your-key
AGENTMESH_MODEL_GPT54_MODEL=GPT-5.4-joybuilder
AGENTMESH_MODEL_GPT54_LABEL=GPT-5.4 JoyBuilder
AGENTMESH_MODEL_GPT54_API_STYLE=chat_completions
AGENTMESH_MODEL_GPT55_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_GPT55_API_KEY=replace-with-your-key
AGENTMESH_MODEL_GPT55_MODEL=GPT-5.5-joybuilder
AGENTMESH_MODEL_GPT55_LABEL=GPT-5.5 JoyBuilder
AGENTMESH_MODEL_GPT55_API_STYLE=chat_completions
AGENTMESH_MODEL_KIMI_K26_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_KIMI_K26_API_KEY=replace-with-your-key
AGENTMESH_MODEL_KIMI_K26_MODEL=Kimi-K2.6-joybuilder
AGENTMESH_MODEL_KIMI_K26_LABEL=Kimi K2.6 JoyBuilder
AGENTMESH_MODEL_KIMI_K26_API_STYLE=chat_completions
# Set false only for gateways that reject strict function declarations despite valid additionalProperties=false schemas.
AGENTMESH_SDK_STRICT_TOOLS=true
# Optional automatic fallback for the legacy synthesis path.
AGENTMESH_LLM_FALLBACK_MODEL_ID=
AGENTMESH_CHAT_LLM_TIMEOUT_SECONDS=2.5
AGENTMESH_LLM_TIMEOUT_SECONDS=30
AGENTMESH_LLM_CONNECT_TIMEOUT_SECONDS=5
AGENTMESH_WEB_PROVIDER=
AGENTMESH_TAVILY_API_URL=https://api.tavily.com/search
AGENTMESH_TAVILY_API_KEY=replace-with-your-key
AGENTMESH_TAVILY_TIMEOUT_SECONDS=20
AGENTMESH_OPENCLI_COMMAND=opencli
AGENTMESH_OPENCLI_COMMAND_TEMPLATE=
AGENTMESH_AGENT_BROWSER_COMMAND=agent-browser
AGENTMESH_AGENT_BROWSER_COMMAND_TEMPLATE=
# Oxygen-CLI internal provider (auth is handled by the installed CLI's own login state)
AGENTMESH_O2_RESEARCH_ENABLED=false
AGENTMESH_O2_RESEARCH_CLI=metasearch
AGENTMESH_O2_DATA_ENABLED=false
AGENTMESH_O2_DATA_CLI=metasearch
AGENTMESH_O2_METASEARCH_ENDPOINT=https://agentkits-a2a-gateway.jd.com/agents/sku-search
AGENTMESH_DATA_API_URL=
AGENTMESH_DATA_API_KEY=
AGENTMESH_DATA_API_TIMEOUT_SECONDS=20
AGENTMESH_OAUTH_ENABLED=false
AGENTMESH_OAUTH_PROVIDER=corporate_oauth
AGENTMESH_OAUTH_AUTHORIZE_URL=
AGENTMESH_OAUTH_TOKEN_URL=
AGENTMESH_OAUTH_USERINFO_URL=
AGENTMESH_OAUTH_CLIENT_ID=
AGENTMESH_OAUTH_CLIENT_SECRET=
AGENTMESH_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/api/auth/oauth/callback
AGENTMESH_OAUTH_SCOPE=openid profile email
AGENTMESH_OAUTH_DEFAULT_ROLE=user
AGENTMESH_AUTO_POST_WORKER_ENABLED=false
AGENTMESH_AUTO_POST_WORKER_INTERVAL_SECONDS=30
