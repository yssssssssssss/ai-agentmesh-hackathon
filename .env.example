AGENTMESH_DB_PATH=data/agentmesh.sqlite3
AGENTMESH_PORT=8010
# Public browser origin used in Runner enrollment links. Override behind a reverse proxy.
AGENTMESH_PUBLIC_URL=http://127.0.0.1:8010
# Keep legacy until the SDK runtime, model, and required Wiki corpus are configured.
AGENTMESH_AGENT_RUNTIME=legacy
# Ordinary local SDK Run model budget. Frozen at first reservation; shared across
# planning, nodes, approvals, synthesis and Session compaction. Unknown usage
# retains its conservative input/output reservation. DeepSearch keeps its ledger.
AGENTMESH_RUN_MODEL_MAX_CALLS=32
AGENTMESH_RUN_MODEL_MAX_TOKENS=256000
AGENTMESH_RUN_MODEL_MAX_OUTPUT_TOKENS=65536
AGENTMESH_RUN_MODEL_MAX_REQUEST_ATTEMPTS=3
# Ordinary local SDK tool admission attempts share that frozen Run policy.
# Keep the existing maximum of 24; operators may tighten it to an integer 1..24.
# Capacity-delayed refusals retain admitted attempts; approvals/reopen do not refund.
AGENTMESH_RUN_MAX_TOOL_CALLS=24
# Optional declared prices keyed by the actual SDK model name; never Provider invoices.
# Rates are integer millionths of currency per million input/output tokens.
# Example only: {"actual-model-name":{"currency":"USD","version":"operator-v1","input_micros_per_million_tokens":1000000,"output_micros_per_million_tokens":2000000}}
# Optional validity: timezone-aware valid_from (inclusive) and valid_until (exclusive).
# The entire price map and limits freeze at the Run's first reservation.
AGENTMESH_RUN_MODEL_PRICES_JSON=
# Enable a cost gate by setting BOTH; missing/expired/wrong-currency prices refuse calls.
# MAX_COST_MICROS uses millionths of the declared currency (1000000 = 1 currency unit).
AGENTMESH_RUN_MODEL_COST_CURRENCY=
AGENTMESH_RUN_MODEL_MAX_COST_MICROS=
# Project inspection triggers: off | observe (read-only diagnostics) | execute (SDK Runtime required).
AGENTMESH_AUTOMATION_MODE=off
# Execution location for new direct Runs: server | runner. Keep server until a local Runner is enrolled.
AGENTMESH_EXECUTION_LOCATION=server
# Path-separator-delimited roots available to explicitly granted local Runner file tools.
AGENTMESH_RUNNER_ALLOWED_ROOTS=
# Multi-Skill orchestration is server-controlled; the frontend reads the effective value
# from /api/bootstrap. Use preview for plan-only validation, then execute after gates pass.
# Valid values: off | preview | execute. Invalid values fail closed to off.
AGENTMESH_SKILL_ORCHESTRATION=off
# Task Center is read-only by default. Set write only after the Task mutation slice is approved.
# Valid values: read_only | write. Invalid values fail application access closed.
AGENTMESH_TASK_MANAGEMENT=read_only
# Automatic Memory context for Task-linked and private Workspace AgentRuns: off | observe | inject.
AGENTMESH_MEMORY_CONTEXT=off
AGENTMESH_MEMORY_LEARNING=off
# Task/Scenario routing can be enabled independently and rolled back without changing stored Runs.
AGENTMESH_TASK_SCENARIO_ROUTING=false
# DeepSearch is released slice-by-slice and remains unavailable until every server gate is ready.
AGENTMESH_DEEPSEARCH_ENABLED=false
AGENTMESH_WIKI_ROOT=
# Set to 1 only for a local demo database. Leave disabled in production.
AGENTMESH_DEMO_MODE=0
AGENTMESH_EMBEDDING_ENABLED=false
AGENTMESH_EMBEDDING_API_URL=http://internal-llm-gateway/v1/embeddings
AGENTMESH_EMBEDDING_API_KEY=replace-with-your-key
AGENTMESH_EMBEDDING_MODEL=Qwen3-Embedding-8B-joybuilder
# OpenAI-compatible chat gateway. Keep real API keys in ignored .env only.
AI_API_URL=http://internal-llm-gateway/v1/chat/completions
AI_API_KEY=replace-with-your-key
AI_MODEL=GPT-5.2-joybuilder
AI_API_STYLE=chat_completions
AGENTMESH_MODEL_DEFAULT=default
AGENTMESH_MODELS=gpt52,gpt54,gpt55
AGENTMESH_MODEL_GPT52_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_GPT52_API_KEY=replace-with-your-key
AGENTMESH_MODEL_GPT52_MODEL=GPT-5.2-joybuilder
AGENTMESH_MODEL_GPT52_LABEL=GPT-5.2 JoyBuilder
AGENTMESH_MODEL_GPT52_API_STYLE=chat_completions
AGENTMESH_MODEL_GPT54_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_GPT54_API_KEY=replace-with-your-key
AGENTMESH_MODEL_GPT54_MODEL=GPT-5.4-joybuilder
AGENTMESH_MODEL_GPT54_LABEL=GPT-5.4 JoyBuilder
AGENTMESH_MODEL_GPT54_API_STYLE=chat_completions
AGENTMESH_MODEL_GPT55_BASE_URL=http://internal-llm-gateway/v1
AGENTMESH_MODEL_GPT55_API_KEY=replace-with-your-key
AGENTMESH_MODEL_GPT55_MODEL=GPT-5.5-joybuilder
AGENTMESH_MODEL_GPT55_LABEL=GPT-5.5 JoyBuilder
AGENTMESH_MODEL_GPT55_API_STYLE=chat_completions
# JoyBuilder supports JSON mode but not OpenAI Native Structured Outputs (json_schema).
# Keep json_schema for providers that implement it. A named model can override this with
# AGENTMESH_MODEL_<ID>_STRUCTURED_OUTPUT_MODE.
AGENTMESH_SDK_STRUCTURED_OUTPUT_MODE=json_object
# Set false only for gateways that reject strict function declarations despite valid additionalProperties=false schemas.
AGENTMESH_SDK_STRICT_TOOLS=true
# Optional automatic fallback for the legacy synthesis path.
AGENTMESH_LLM_FALLBACK_MODEL_ID=
AGENTMESH_CHAT_LLM_TIMEOUT_SECONDS=120
AGENTMESH_RESEARCH_SKILL_TIMEOUT_SECONDS=180
# Interactive semantic Skill matching uses a dedicated budget shorter than chat requests.
AGENTMESH_SKILL_MATCH_LLM_TIMEOUT_SECONDS=8
AGENTMESH_LLM_TIMEOUT_SECONDS=30
AGENTMESH_LLM_CONNECT_TIMEOUT_SECONDS=5
# Optional Web provider used by current Skills and agents. Use "tavily" with an approved secret.
AGENTMESH_WEB_PROVIDER=
AGENTMESH_TAVILY_API_URL=https://api.tavily.com/search
AGENTMESH_TAVILY_API_KEY=
AGENTMESH_TAVILY_TIMEOUT_SECONDS=20
# Optional Tavily search + Firecrawl REST scrape enrichment.
AGENTMESH_FIRECRAWL_ENABLED=false
AGENTMESH_FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape
AGENTMESH_FIRECRAWL_API_KEY=
AGENTMESH_FIRECRAWL_TIMEOUT_SECONDS=60
AGENTMESH_FIRECRAWL_MAX_PAGES=6
AGENTMESH_FIRECRAWL_MAX_CONTENT_CHARS=4000
AGENTMESH_OPENCLI_COMMAND=opencli
AGENTMESH_OPENCLI_COMMAND_TEMPLATE=
AGENTMESH_AGENT_BROWSER_COMMAND=agent-browser
AGENTMESH_AGENT_BROWSER_COMMAND_TEMPLATE=
# Oxygen-CLI internal provider (auth is handled by the installed CLI's own login state)
AGENTMESH_O2_RESEARCH_ENABLED=false
AGENTMESH_O2_RESEARCH_CLI=metasearch
AGENTMESH_O2_DATA_ENABLED=false
AGENTMESH_O2_DATA_CLI=metasearch
AGENTMESH_O2_METASEARCH_ENDPOINT=https://agentkits-a2a-gateway.jd.com/agents/sku-search
AGENTMESH_DATA_API_URL=
AGENTMESH_DATA_API_KEY=
AGENTMESH_DATA_API_TIMEOUT_SECONDS=20
# Explicit project binding for read-only source synchronization (disabled while empty).
# Sync APIs accept a provider and expected cursor version; paths/repositories are operator configuration.
AGENTMESH_CONNECTOR_PROJECT_ID=
# Server-side worker is opt-in; each owner must also explicitly enable automatic sync for a cursor.
AGENTMESH_CONNECTOR_WORKER_ENABLED=false
AGENTMESH_REPO_DOCS_ROOT=
AGENTMESH_GITHUB_REPOSITORY=
# Public repositories need no token. Private repository credentials stay on the server.
AGENTMESH_GITHUB_TOKEN=
# Required when a token is configured; change this version when its principal/permission binding changes.
AGENTMESH_GITHUB_CREDENTIAL_VERSION=anonymous
AGENTMESH_OAUTH_ENABLED=false
AGENTMESH_OAUTH_PROVIDER=corporate_oauth
AGENTMESH_OAUTH_AUTHORIZE_URL=
AGENTMESH_OAUTH_TOKEN_URL=
AGENTMESH_OAUTH_USERINFO_URL=
AGENTMESH_OAUTH_CLIENT_ID=
AGENTMESH_OAUTH_CLIENT_SECRET=
AGENTMESH_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/api/auth/oauth/callback
AGENTMESH_OAUTH_SCOPE=openid profile email
AGENTMESH_OAUTH_DEFAULT_ROLE=user
AGENTMESH_AUTO_POST_WORKER_ENABLED=false
AGENTMESH_AUTO_POST_WORKER_INTERVAL_SECONDS=30
# Runs at 00:05 Asia/Shanghai, summarizes the previous day, and catches up yesterday on startup.
AGENTMESH_DAILY_MEMORY_WORKER_ENABLED=false
